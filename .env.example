# ═══════════════════════════════════════════════════════════
# News Automation Pipeline — Environment Configuration
# Copy this file to .env and fill in your values.
# ═══════════════════════════════════════════════════════════

# ── Database ───────────────────────────────────────────────
DATABASE_URL=sqlite:///./news.db
# For production use PostgreSQL:
# DATABASE_URL=postgresql://user:pass@localhost:5432/news_pipeline

# ── Logging ────────────────────────────────────────────────
LOG_LEVEL=INFO
GEO_FOCUS=IN          # IN | US | GB | GLOBAL

# ── Stage 1: News Sources ──────────────────────────────────
NEWSAPI_KEY=                          # https://newsapi.org
REDDIT_CLIENT_ID=                     # https://www.reddit.com/prefs/apps
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=NewsPipeline/1.0

# Discovery scheduler
DISCOVERY_INTERVAL_MINUTES=30
MAX_STORIES_PER_RUN=100
MIN_CREDIBILITY_SCORE=40

# ── Stage 3+4: AI Providers ────────────────────────────────
# Provider is inferred from model name prefix:
#   claude-*  → ANTHROPIC_API_KEY
#   gpt-* / o1-* / o3-* / o4-*  → OPENAI_API_KEY
#   gemini-*  → GEMINI_API_KEY

ANTHROPIC_API_KEY=                    # https://console.anthropic.com
OPENAI_API_KEY=                       # https://platform.openai.com
GEMINI_API_KEY=                       # https://aistudio.google.com

ARTICLE_MODEL=claude-sonnet-4-6       # Model for article writing
SEO_MODEL=                            # Leave empty to reuse ARTICLE_MODEL

# Stage 3: Fact verification
BING_SEARCH_API_KEY=                  # https://portal.azure.com (Bing Search v7)
MIN_VERIFICATION_SOURCES=3            # 3-source rule threshold
CREDIBILITY_THRESHOLD=75              # Minimum score to pass verification
VERIFICATION_TIMEOUT_SECONDS=10

# Stage 4: Article writing
ARTICLE_WORD_COUNT=700
ARTICLE_MAX_TOKENS=2048

# Stage 4: Image generation (optional)
IMAGE_GENERATION_ENABLED=false        # Set to true to enable DALL-E
DALLE_MODEL=dall-e-3

# Verification + Writing scheduler
PIPELINE_INTERVAL_MINUTES=60

# ── Stage 5: Dashboard ─────────────────────────────────────
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=8000
DASHBOARD_SECRET_KEY=                     # Generate: python -c "import secrets; print(secrets.token_hex(32))"
DASHBOARD_API_KEY=                        # API key to protect dashboard endpoints (leave empty for local dev)
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# ── Stage 6: WordPress Publisher ───────────────────────────
WORDPRESS_URL=                        # e.g. https://yoursite.com
WORDPRESS_USERNAME=                   # WordPress admin username
WORDPRESS_APP_PASSWORD=               # Settings → Users → Application Passwords

# Stage 6: Social distribution
BUFFER_ACCESS_TOKEN=                  # https://buffer.com/developers
BUFFER_PROFILE_IDS=                   # Comma-separated profile IDs

# Stage 6: Newsletter
MAILCHIMP_API_KEY=                    # https://mailchimp.com/developer
MAILCHIMP_LIST_ID=                    # Audience list ID

# ── Stage 7: Analytics ─────────────────────────────────────
GA4_PROPERTY_ID=                      # Google Analytics 4 property ID
GOOGLE_SERVICE_ACCOUNT_JSON=          # Path to service account key JSON file
